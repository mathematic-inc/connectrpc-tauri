amends
  "package://github.com/mathematic-inc/toolconfig/releases/download/v2026.11.6/toolconfig@2026.11.6#/ToolConfig.pkl"

root = true

toolconfig {
  `extends` =
    List(new Repository {
      git = "https://github.com/mathematic-inc/toolconfig-config.git"
      rev = "56ddc9b031a44165668fc9ed41f90e62a4e31ea5"
      path = "profiles/org/.toolconfig.pkl"
    })
}

sections {
  ["*"] {
    typos {
      ["default"] {
        // `sherif` is a tool name, not a misspelling of "sheriff".
        ["extend-identifiers"] { ["Sherif"] = "Sherif"; ["sherif"] = "sherif" }
        ["extend-words"] { ["Sherif"] = "Sherif"; ["sherif"] = "sherif" }
      }
    }
    // Tauri generates the permissions folder.
    oxfmt {
      ignorePatterns =
        List(
          "**/dist/**",
          "**/gen/**",
          "**/generated/**",
          "**/node_modules/**",
          "**/target/**",
          "**/vendor/**",
          "**/*.md",
          "**/*.toml",
          "**/permissions/**",
        )
    }
    oxlint {
      rules {
        ["typescript/prefer-readonly-parameter-types"] {
          "deny"
          new {
            allow =
              List(
                // The DOM and the ECMAScript library have no readonly form of these types.
                new Dynamic {
                  from = "lib"
                  name =
                    List(
                      "AbortSignal",
                      "ArrayBuffer",
                      "AsyncIterable",
                      "Headers",
                      "Iterable",
                      "Uint8Array",
                    )
                },
                // Connect's request and response types have mutable headers and streams.
                new Dynamic {
                  from = "package"
                  package = "@connectrpc/connect"
                  name =
                    List(
                      "StreamRequest",
                      "UnaryRequest",
                      "UniversalClientRequest",
                    )
                },
                // The `registry` of the Protobuf-ES options is an interface with methods.
                new Dynamic {
                  from = "package"
                  package = "@bufbuild/protobuf"
                  name = List("Registry")
                },
              )
          }
        }
      }
    }
    rumdl {
      global {
        exclude =
          List(
            "**/dist/**",
            "**/gen/**",
            "**/generated/**",
            "**/node_modules/**",
            "**/target/**",
            "**/vendor/**",
            "**/CHANGELOG.md",
            "**/permissions/**",
          )
      }
    }
    knip {
      workspaces {
        // These binaries are pinned in mise.toml, not npm.
        ["."] { ignoreBinaries = List("buf", "hk", "oxfmt", "oxlint", "toolconfig") }
      }
      ignore = List("**/src/gen/**")
    }
    `cargo-deny` {
      // An `unmaintained` advisory, not a vulnerability, with no upgrade available. Drop the entry
      // once Tauri moves off the crate.
      advisories {
        ignore {
          new { id = "RUSTSEC-2024-0370"; reason = "proc-macro-error, via Tauri's macro crates" }
        }
      }
      // Tauri's tree has duplicate versions that this repository cannot control.
      bans { ["multiple-versions"] = "allow" }
      licenses {
        exceptions {
          new { crate = "cssparser"; allow = List("MPL-2.0") }
          new { crate = "cssparser-macros"; allow = List("MPL-2.0") }
          new { crate = "dtoa-short"; allow = List("MPL-2.0") }
          new { crate = "option-ext"; allow = List("MPL-2.0") }
          new { crate = "selectors"; allow = List("MPL-2.0") }
          new { crate = "target-lexicon"; allow = List("Apache-2.0 WITH LLVM-exception") }
        }
      }
    }
  }
  ["*.proto"] {
    buf {
      modules { new { path = "proto" } }
      lint {
        // The demo service shares one request and response across all four method kinds, so that
        // the example runs them on identical messages.
        ignore_only {
          ["RPC_REQUEST_RESPONSE_UNIQUE"] = List("proto/greet/v1/greet.proto")
          ["RPC_REQUEST_STANDARD_NAME"] = List("proto/greet/v1/greet.proto")
          ["RPC_RESPONSE_STANDARD_NAME"] = List("proto/greet/v1/greet.proto")
        }
      }
    }
  }
}
