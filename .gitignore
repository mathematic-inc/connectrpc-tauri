# Dependencies and build output. `dist/` and `node_modules/` are unanchored
# because npm workspaces put both under `packages/*` and `examples/*` too.
node_modules/
target/
dist/
*.tsbuildinfo

# Generated by Tauri's build script.
examples/greet-app/src-tauri/gen/

# Tool caches and scratch space.
.rumdl_cache/
.trash/
# A misconfigured RUSTUP_HOME writes a rustup tree here instead of ~/.rustup.
# Ignored so a stray copy never reaches a commit or a lint run.
undefined/

# Copied in by the transport package's `prepack` so npm ships them; npm does
# not follow symlinks the way cargo does.
packages/transport/README.md
packages/transport/LICENSE-MIT
packages/transport/LICENSE-APACHE

# Local secrets. `gitleaks` catches these at commit time, but only after they
# have already been staged.
.env
.env.*

# macOS.
.DS_Store
