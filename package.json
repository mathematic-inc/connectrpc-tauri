{
  "name": "connectrpc-tauri-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/greet-app"
  ],
  "scripts": {
    "build": "npm run build --workspace @connectrpc-tauri/transport",
    "check": "oxlint --deny-warnings . && oxfmt --check .",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "format": "oxfmt --write .",
    "generate": "buf generate && npm run generate --workspace greet-app",
    "lint": "oxlint --deny-warnings .",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@12.0.2"
}
