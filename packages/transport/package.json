{
  "name": "@connectrpc-tauri/transport",
  "version": "0.1.1",
  "description": "ConnectRPC transport over Tauri IPC (commands + channels)",
  "keywords": [
    "tauri",
    "connectrpc",
    "grpc",
    "ipc",
    "rpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathematic-inc/connectrpc-tauri.git",
    "directory": "packages/transport"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "cp ../../README.md ../../LICENSE-MIT ../../LICENSE-APACHE ."
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@tauri-apps/api": "^2.11.1"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.0",
    "@tauri-apps/api": "^2.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
