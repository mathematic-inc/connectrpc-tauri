{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "greet-app",
  "version": "0.1.0",
  "identifier": "com.connectrpc.tauri.greet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ConnectRPC over Tauri IPC",
        "width": 720,
        "height": 780
      }
