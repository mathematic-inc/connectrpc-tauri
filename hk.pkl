amends ".hk/org.pkl"

// Tauri generates the permissions folder.
exclude = super.exclude + List("**/permissions/**")

local nodeFiles =
  List(
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.base.json",
    "packages/*/**",
    "examples/*/**",
  )
local slow = List("slow")

steps {
  // The example is the only file with root-relative links.
  ["lychee"] {
    check = "lychee --no-progress --root-dir examples/greet-app {{ files }}"
    workspace_indicator = "package.json"
  }
  ["protobuf-bindings"] = new Step {
    glob = List("proto/**", "**/buf.gen.yaml", "**/src/gen/**")
    check =
      "npm run --silent generate && git diff --exit-code -- packages/transport/src/gen examples/greet-app/src/gen"
    fix = "npm run --silent generate"
    depends = "buf-lint"
  }
  // The crate's bindings are checked in so building it needs no `protoc`.
  ["rust-protobuf-bindings"] = new Step {
    glob =
      List(
        "proto/**",
        "tools/protobuf-bindings/**",
        "crates/connectrpc-tauri/src/generated/**",
        "Cargo.lock",
      )
    check =
      "cargo run --locked --quiet -p protobuf-bindings && git diff --exit-code -- crates/connectrpc-tauri/src/generated && test -z \"$(git ls-files --others --exclude-standard -- crates/connectrpc-tauri/src/generated)\""
    fix = "cargo run --locked --quiet -p protobuf-bindings"
    depends = "buf-lint"
    profiles = slow
  }
  ["knip"] = new Step {
    types = List("javascript", "typescript")
    check = "knip --no-progress --treat-config-hints-as-errors"
    fix = "knip --fix --no-progress --treat-config-hints-as-errors"
    profiles = slow
  }
  ["sherif"] = new Step {
    glob = List("**/package.json", "**/pnpm-workspace.yaml")
    check = "sherif --fail-on-warnings"
    fix = "sherif --fix --no-install --fail-on-warnings"
    profiles = slow
  }
  ["typecheck"] = new Step {
    glob = nodeFiles
    check = "npm run --silent typecheck"
    profiles = slow
  }
  ["vitest"] = new Step {
    glob = nodeFiles
    check = "npm test --silent"
    depends = "typecheck"
    profiles = slow
  }
  ["cargo-lockfile"] = new Step {
    glob = List("Cargo.toml", "Cargo.lock", "**/Cargo.toml")
    check = "cargo metadata --locked --format-version 1 --all-features > /dev/null"
    profiles = slow
  }
}
