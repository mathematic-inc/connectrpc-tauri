amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/builtins/test/helpers.pkl"

// Generated code is committed so consumers get bindings without running
// codegen, but it is not ours to format or lint. `src/gen` comes from
// `buf generate` and `permissions/` from Tauri's build script, which emits
// its schema without a trailing newline. Excluded globally rather than
// per-step so no formatter rewrites a file its generator will overwrite.
exclude = List("**/src/gen/**", "crates/*/permissions/**")

// Files that can change what `npm run typecheck`/`test`/`build` produce.
local nodeFiles =
  List(
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.base.json",
    "packages/*/**",
    "examples/*/**",
  )

local checks = new Mapping<String, Step> {
  ["bom"] = Builtins.byte_order_marker
  ["case-conflicts"] = Builtins.check_case_conflict
  ["executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["large-files"] = Builtins.check_added_large_files
  ["merge-conflicts"] = Builtins.check_merge_conflict
  ["mixed-line-endings"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["private-keys"] = Builtins.detect_private_key
  ["symlinks"] = Builtins.check_symlinks
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["gitleaks"] = (Builtins.gitleaks) {
    // `gitleaks dir` walks the tree it is pointed at, including gitignored
    // build output, which turns `target/` artifacts into false positives.
    // Scanning git instead sees only what is committed or staged.
    check =
      "gitleaks git --redact --verbose --no-banner --timeout 60 --log-opts=--all . && gitleaks git --redact --verbose --no-banner --pre-commit --staged ."
    tests = new Mapping<String, StepTest> {
      local const testMaker = new helpers.TestMaker {
        filename = "foo.txt"
        before =
          "git init -q && git add . && git -c user.name=hk -c user.email=hk@example.com commit -qm test"
      }
      local const bad = "awsToken = " + "AKIA" + "LALEMEL33243OLIA"
      ["check bad file"] = testMaker.checkFail(bad, 1)
      ["check good file"] = testMaker.checkPass("message = foobar")
    }
  }
  ["typos"] = Builtins.typos

  // Markdown and prose.
  ["ryl-markdown"] = (Builtins.ryl_markdown) {
    depends = "typos"
  }
  ["rumdl-format"] = (Builtins.rumdl_format) {
    depends = "ryl-markdown"
  }
  ["rumdl"] = (Builtins.rumdl) {
    depends = "rumdl-format"
  }
  ["harper"] = (Builtins.harper) {
    types = List("markdown")
    // The ignore list is technical-prose noise: `AnA` and `CompoundNouns`
    // misread identifiers like `mpsc` and `hash map`, `ExpandTimeShorthands`
    // rewrites the `ms` units in the benchmark table, and `LongSentences` is
    // style, not correctness. `ExpandArgument` would rewrite `invoke` args,
    // which is the Tauri API's own term.
    check =
      "harper-cli --no-color lint --quiet --format compact --ignore SpellCheck,UseTitleCase,SplitWords,SentenceCapitalization,OxfordComma,OrthographicConsistency,NumericRangeEnDash,MissingTo,MassNouns,DisjointPrefixes,PhrasalVerbAsCompoundNoun,ExpandControl,ExpandMemoryShorthands,WrongNegative,AnA,CompoundNouns,ExpandTimeShorthands,LongSentences,HopHope,ExpandArgument {{ files }}"
    depends = "rumdl"
  }
  ["lychee"] = (Builtins.lychee) {
    types = List("markdown", "html")
    // `--root-dir` takes one absolute path, but a root-relative link resolves
    // against whichever Vite root serves the file, so each workspace is
    // checked from its own directory.
    check =
      "cd {{workspace}} && lychee --offline --no-progress --root-dir \"$PWD\" {{ workspace_files }}"
    workspace_indicator = "package.json"
    depends = "rumdl"
  }

  // Config formats.
  ["pkl-format"] = Builtins.pkl_format
  ["pkl"] = (Builtins.pkl) {
    depends = "pkl-format"
  }
  ["tombi-format"] = (Builtins.tombi_format) {
    depends = "typos"
  }
  ["tombi"] = (Builtins.tombi) {
    depends = "tombi-format"
  }
  ["mise"] = (Builtins.mise) {
    depends = "tombi-format"
  }

  // GitHub Actions.
  ["pinact"] = (Builtins.pinact) {
    check_diff = "pinact run --fix=false --no-api {{ files }}"
    tests = new Mapping<String, StepTest> {
      local const testMaker = new helpers.TestMaker {
        before = "pinact init"
        filename = ".github/workflows/test.yml"
      }
      local const bad =
        """
        name: pinact test
        on:
          push:
        jobs:
          test:
            runs-on: ubuntu-latest
            steps:
              - uses: actions/checkout@v6.0.1

        """
      local const good =
        """
        name: pinact test
        on:
          push:
        jobs:
          test:
            runs-on: ubuntu-latest
            steps:
              - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1

        """
      ["check bad file"] = testMaker.checkFail(bad, 2)
      ["check good file"] = testMaker.checkPass(good)
    }
  }
  ["zizmor"] = (Builtins.zizmor) {
    // Fail on findings that carry a severity. `superfluous-actions` and
    // friends are informational style advice, not security problems.
    check_diff = "zizmor --no-progress --min-severity low {{ files }}"
    fix = "zizmor --no-progress --min-severity low --fix {{ files }}"
    depends = "pinact"
    // The upstream fixtures predate this zizmor pin and trip its own
    // `unpinned-uses` policy, so the actions here are pinned by hash.
    tests = new Mapping<String, StepTest> {
      local const testMaker = new helpers.TestMaker {
        filename = ".github/workflows/action.yaml"
      }
      local const bad =
        """
        name: hk test
        on:
          push:
        permissions: {}
        jobs:
          build:
            runs-on: ubuntu-latest
            steps:
              - uses: actions/checkout/////@8e8c483db84b4bee98b60c0593521ed34d9990e8
                with:
                  persist-credentials: false

        """
      local const good =
        """
        name: hk test
        on:
          push:
        permissions: {}
        jobs:
          build:
            runs-on: ubuntu-latest
            steps:
              - uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8
                with:
                  persist-credentials: false

        """
      ["check bad file"] = testMaker.checkFail(bad, 12)
      ["check good file"] = testMaker.checkPass(good)
      ["fix bad file"] = testMaker.fixPass(bad, good)
      ["fix good file"] = testMaker.fixPass(good, good)
    }
  }
  ["ryl"] = (Builtins.ryl) {
    depends = "zizmor"
  }
  ["actionlint"] = (Builtins.actionlint) {
    depends = "ryl"
  }
  ["ghalint"] = (Builtins.ghalint_workflow) {
    depends = "actionlint"
  }

  // Protobuf. The wire format is the crate's public API, so the protos are
  // linted before anything downstream regenerates from them.
  ["buf-format"] = Builtins.buf_format
  ["buf-lint"] = (Builtins.buf_lint) {
    depends = "buf-format"
  }
  // The committed bindings must match the protos they came from.
  ["protobuf-bindings"] {
    glob = List("proto/**", "**/buf.gen.yaml", "**/src/gen/**")
    // `git diff` needs real paths: a `**/src/gen` pathspec matches nothing
    // here and would make this check pass unconditionally. Comparing the
    // worktree against the index is the right test: pre-commit stashes
    // unstaged edits first, so regenerating and finding a difference means
    // the staged bindings do not match the staged protos.
    check =
      "npm run --silent generate && git diff --exit-code -- packages/transport/src/gen examples/greet-app/src/gen"
    fix = "npm run --silent generate"
    depends = "buf-lint"
  }

  // JavaScript/TypeScript.
  ["oxlint"] = (Builtins.ox_lint) {
    depends = "protobuf-bindings"
    // The upstream fixture relies on a rule this repo leaves at warning, so
    // `--fix` never rewrites it. This rule is denied here and auto-fixable;
    // the sandbox gets its own config since the repo's does not reach it.
    tests = new Mapping<String, StepTest> {
      local const testMaker = new helpers.TestMaker {
        filename = "foo.ts"
        extra_files = new Mapping<String, String> {
          [".oxlintrc.json"] = "{\"rules\":{\"unicorn/prefer-string-starts-ends-with\":\"deny\"}}"
        }
      }
      local const bad = "export const f = (s: string) => /^a/u.test(s);\n"
      local const good = "export const f = (s: string) => s.startsWith('a');\n"
      ["check bad file"] = testMaker.checkFail(bad, 1)
      ["check good file"] = testMaker.checkPass(good)
      ["fix bad file"] = testMaker.fixPass(bad, good)
      ["fix good file"] = testMaker.fixPass(good, good)
    }
  }
  ["sort-package-json"] = Builtins.sort_package_json
  ["oxfmt"] = (Builtins.oxfmt) {
    // TOML has its own formatter and package.json its own sorter.
    // The changelogs belong to Release Please, which rewrites them on every
    // release; reformatting them here only loses the next release PR's diff.
    exclude =
      List(
        "**/*.toml",
        "**/package.json",
        "package-lock.json",
        "**/CHANGELOG.md",
      )
    depends = List("oxlint", "sort-package-json")
  }
  ["jq"] = (Builtins.jq) {
    check = "jq empty {{ files }}"
    check_diff = null
    fix = null
    // oxlint and knip read their configs as JSONC; `jq` rejects the comments.
    exclude = List(".oxlintrc.json", "knip.json")
    depends = "oxfmt"
    tests = new Mapping<String, StepTest> {
      local const testMaker = new helpers.TestMaker { filename = "test.json" }
      ["check bad file"] = testMaker.checkFail("{\"test\":}", 5)
      ["check good file"] = testMaker.checkPass("{\"test\":123}")
    }
  }
  ["knip"] = (Builtins.knip) {
    workspace_indicator = null
    check = "knip --no-progress --treat-config-hints-as-errors"
    fix = "knip --fix --no-progress --treat-config-hints-as-errors"
    depends = "oxfmt"
  }
  ["sherif"] = (Builtins.sherif) {
    check = "sherif --fail-on-warnings"
    fix = "sherif --fix --no-install --fail-on-warnings"
    depends = "knip"
  }
  ["typecheck"] {
    glob = nodeFiles
    check = "npm run --silent typecheck"
    depends = "oxfmt"
  }
  ["vitest"] {
    glob = nodeFiles
    check = "npm test --silent"
    depends = "typecheck"
  }

  // Rust.
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    glob = List("**/Cargo.toml", "Cargo.lock", "**/*.rs", "proto/**")
    workspace_indicator = null
    check = "cargo clippy --workspace --all-features --all-targets -- -D warnings"
    fix =
      "cargo clippy --fix --workspace --all-features --all-targets --allow-dirty --allow-staged -- -D warnings"
    check_first = true
  }
  ["cargo-fmt"] = (Builtins.cargo_fmt) {
    depends = "cargo-clippy"
  }
  ["cargo-deny"] = (Builtins.cargo_deny) {
    workspace_indicator = null
    check = "cargo-deny --locked --workspace check"
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checks
  }
  ["fix"] {
    fix = true
    steps = checks
  }
  ["check"] {
    steps = checks
  }
}
